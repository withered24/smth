            },
            {
              "value": "some",
              "label": "Partly"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AR · Comparison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Silent in meetings and classes",
            "us": "yes",
            "c1": "yes",
            "c2": "no",
            "c3": "some"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Worn all day, nothing to carry",
            "us": "yes",
            "c1": "no",
            "c2": "no",
            "c3": "no"
          }
        },
        {
