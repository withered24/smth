{%- liquid
  assign cta_product = section.settings.product
  if cta_product == blank and product != blank
    assign cta_product = product
  endif
  assign cta_url = section.settings.button_link
  if template.name == 'product'
    assign cta_url = '#ar-buy'
  elsif cta_product != blank
    assign cta_url = cta_product.url
  endif
  if cta_url == blank
    assign cta_url = routes.all_products_collection_url
  endif
  assign cta_label = section.settings.button_label
  if section.settings.show_price and cta_product != blank
    assign cta_price = cta_product.price | money
    assign cta_label = cta_label | append: ' · ' | append: cta_price
  endif
-%}{%- render 'ar-assets' -%}
<section class="ar ar-section ar-section--tight {{ section.settings.background }}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="ar-container">
    <div class="ar-final" data-ar-reveal>
      <div class="ar-media">
        {%- render 'ar-image', image: section.settings.image, sizes: '(min-width: 850px) 50vw, 100vw', placeholder: 'lifestyle-2' -%}
      </div>
      <div class="ar-final__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="ar-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ar-h2">{{ section.settings.heading }}</h2>
        <div class="ar-lead">{{ section.settings.text }}</div>
        <a class="ar-btn ar-btn--gold" href="{{ cta_url }}">{{ cta_label }}{% render 'ar-icon', name: 'arrow' %}</a>
        <ul class="ar-assurance">
          {%- for i in (1..3) -%}
            {%- assign key = 'assurance_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li><span>{% render 'ar-icon', name: 'check' %}{{ section.settings[key] }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AR · Final call to action",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Keep your remembrance close"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Make dhikr part of <em>every</em> day"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>For yourself, or for someone you love: a parent, a spouse, or a friend who is new to Islam.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Dhikr Ring"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Buttons link here and show its price."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Fallback link"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price on button",
      "default": true
    },
    {
      "type": "header",
      "content": "Reassurance line"
    },
    {
      "type": "text",
      "id": "assurance_1",
      "label": "Item 1",
      "default": "Free US shipping"
    },
    {
      "type": "text",
      "id": "assurance_2",
      "label": "Item 2",
      "default": "60-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "assurance_3",
      "label": "Item 3",
      "default": "1-year warranty"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "ar--white",
      "options": [
        {
          "value": "ar--white",
          "label": "White"
        },
        {
          "value": "ar--paper",
          "label": "Paper"
        },
        {
          "value": "ar--cream",
          "label": "Cream"
        },
        {
          "value": "ar--green",
          "label": "Brand green"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Lets other buttons link here with #your-id."
    }
  ],
  "presets": [
    {
      "name": "AR · Final call to action"
    }
  ]
}
{% endschema %}
